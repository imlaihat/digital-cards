<?php

/**
 * Implements hook_schema().
 */
function digital_card_offers_schema(): array {
  $schema['digital_card_partner'] = [
    'description' => 'Contracted merchant partners.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'name' => ['type' => 'varchar', 'length' => 190, 'not null' => TRUE],
      'merchant_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'contact_email' => ['type' => 'varchar', 'length' => 254, 'not null' => FALSE],
      'status' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => ['merchant_uid' => ['merchant_uid'], 'status' => ['status']],
  ];
  $schema['digital_card_offer'] = [
    'description' => 'Offers available to verified card holders.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'partner_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'title' => ['type' => 'varchar', 'length' => 190, 'not null' => TRUE],
      'description' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'discount_label' => ['type' => 'varchar', 'length' => 100, 'not null' => TRUE],
      'starts' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'ends' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'status' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'max_redemptions' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'organization_limit' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'per_holder_limit' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 1],
      'reward_type' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'standard'],
      'points_awarded' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'points_required' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => ['partner_status' => ['partner_id', 'status'], 'active_window' => ['status', 'starts', 'ends']],
