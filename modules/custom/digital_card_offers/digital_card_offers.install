  $schema['digital_card_offer_org'] = [
    'description' => 'Optional organization targeting for offers.',
    'fields' => [
      'offer_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'organization_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['offer_id', 'organization_id'],
    'indexes' => ['organization_id' => ['organization_id']],
  ];
  $schema['digital_card_offer_translation'] = [
    'description' => 'Localized offer presentation text without affecting redemption counters.',
    'fields' => [
      'offer_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'langcode' => ['type' => 'varchar_ascii', 'length' => 12, 'not null' => TRUE],
      'title' => ['type' => 'varchar', 'length' => 190, 'not null' => TRUE],
      'description' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'discount_label' => ['type' => 'varchar', 'length' => 100, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['offer_id', 'langcode'],
    'indexes' => ['langcode' => ['langcode']],
  ];
  $schema['digital_card_offer_redemption'] = [
    'description' => 'Immutable offer redemption audit records.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'offer_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'partner_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'card_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'holder_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'holder_key' => ['type' => 'varchar', 'length' => 140, 'not null' => TRUE, 'default' => ''],
      'organization_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'points_delta' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'points_balance_after' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'merchant_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'reference' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['reference' => ['reference']],
    'indexes' => [
      'offer_holder' => ['offer_id', 'holder_uid'],
      'offer_holder_key' => ['offer_id', 'holder_key'],
      'offer_organization' => ['offer_id', 'organization_id'],
      'merchant_created' => ['merchant_uid', 'created'],
      'card_created' => ['card_nid', 'created'],
    ],
  ];
  $schema['digital_card_points_wallet'] = [
    'description' => 'Fast partner-scoped NFC loyalty point balances.',
    'fields' => [
      'partner_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'holder_key' => ['type' => 'varchar', 'length' => 140, 'not null' => TRUE],
      'organization_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'balance' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'lifetime_earned' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'lifetime_spent' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['partner_id', 'holder_key'],
    'indexes' => ['organization_changed' => ['organization_id', 'changed']],
