<div class="rp-page rp-solutions">
  <section class="rp-subhero rp-subhero--dark" aria-labelledby="rp-solutions-title">
    <div class="rp-shell rp-subhero__grid">
      <div>
        <span class="rp-eyebrow rp-eyebrow--dark">{{ 'Ropleon capabilities'|t }}</span>
        <h1 id="rp-solutions-title">{{ 'Connected solutions for complex organizations.'|t }}</h1>
      </div>
      <p class="rp-lead">{{ 'Ropleon combines software engineering, system integration, cloud architecture, AI-enabled capabilities, and digital platform design to solve operational and customer experience challenges.'|t }}</p>
    </div>
  </section>

  <section class="rp-section rp-solution-list" aria-labelledby="rp-solution-areas-title">
    <div class="rp-shell">
      <div class="rp-editorial-heading rp-editorial-heading--compact">
        <span class="rp-eyebrow">{{ 'Solution areas'|t }}</span>
        <h2 id="rp-solution-areas-title">{{ 'Engineering depth across the connected enterprise.'|t }}</h2>
      </div>
      <div class="rp-solution-rows">
        <article>
          <span>01</span>
          <div class="rp-icon-wrap">{% include '@ropleon_brand/components/ropleon-icon.html.twig' with {icon: 'software'} only %}</div>
          <h3>{{ 'Enterprise Software Development'|t }}</h3>
          <p>{{ 'Secure custom applications and business platforms aligned with real processes and integration requirements.'|t }}</p>
        </article>
        <article>
          <span>02</span>
          <div class="rp-icon-wrap">{% include '@ropleon_brand/components/ropleon-icon.html.twig' with {icon: 'integration'} only %}</div>
          <h3>{{ 'Systems Integration'|t }}</h3>
          <p>{{ 'API, middleware, data, and channel integration across enterprise environments.'|t }}</p>
        </article>
        <article>
          <span>03</span>
          <div class="rp-icon-wrap">{% include '@ropleon_brand/components/ropleon-icon.html.twig' with {icon: 'ai'} only %}</div>
          <h3>{{ 'AI and Intelligent Automation'|t }}</h3>
          <p>{{ 'Practical automation and AI-enabled services designed around measurable business value.'|t }}</p>
        </article>
        <article>
          <span>04</span>
          <div class="rp-icon-wrap">{% include '@ropleon_brand/components/ropleon-icon.html.twig' with {icon: 'cloud'} only %}</div>
          <h3>{{ 'Cloud and Platform Engineering'|t }}</h3>
          <p>{{ 'Scalable digital platforms designed for resilience, maintainability, and controlled growth.'|t }}</p>
        </article>
        <article>
          <span>05</span>
          <div class="rp-icon-wrap">{% include '@ropleon_brand/components/ropleon-icon.html.twig' with {icon: 'identity'} only %}</div>
          <h3>{{ 'Digital Identity Products'|t }}</h3>
          <p>{{ 'Modern identity, profile, and professional presence products led by Ropleon Cards.'|t }}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="rp-section rp-dark-cta">
    <div class="rp-shell rp-dark-cta__inner">
      <div><span class="rp-eyebrow rp-eyebrow--dark">{{ 'Your requirements'|t }}</span><h2>{{ 'Connect the technology your organization depends on.'|t }}</h2></div>
      <a class="rp-button rp-button--primary" href="{{ urls.contact }}">{{ 'Discuss your requirements'|t }}</a>
    </div>
  </section>
</div>
