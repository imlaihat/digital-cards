<div class="rp-page rp-about">
  <section class="rp-subhero" aria-labelledby="rp-about-title">
    <div class="rp-shell rp-subhero__grid">
      <div>
        <span class="rp-eyebrow">{{ brand.company_name_ar }} · {{ brand.company_legal_name }}</span>
        <h1 id="rp-about-title">{{ 'Technology with purpose. Systems that connect.'|t }}</h1>
      </div>
      <p class="rp-lead">{{ 'Ropleon is a technology company focused on building secure, scalable, and connected solutions for modern organizations.'|t }}</p>
    </div>
  </section>

  <section class="rp-section rp-about-intro">
    <div class="rp-shell rp-editorial-split">
      <div>
        <span class="rp-eyebrow">{{ 'Who we are'|t }}</span>
        <h2>{{ 'Practical engineering shaped around real operations.'|t }}</h2>
      </div>
      <div class="rp-prose">
        <p>{{ 'We develop enterprise software, digital platforms, integration solutions, AI-enabled services, cloud capabilities, and digital identity products.'|t }}</p>
        <p>{{ 'Our approach combines practical engineering, thoughtful design, and a clear understanding of how technology must support real organizational operations.'|t }}</p>
      </div>
    </div>
  </section>

  <section class="rp-section rp-purpose">
    <div class="rp-shell rp-purpose__grid">
      <article>
        <span>01</span>
        <small>{{ 'Vision'|t }}</small>
        <h2>{{ 'To build connected digital products and platforms that help organizations work more effectively and create better experiences.'|t }}</h2>
      </article>
      <article>
        <span>02</span>
        <small>{{ 'Mission'|t }}</small>
        <h2>{{ 'To simplify complex technology challenges through reliable software, integration, intelligent automation, and purposeful digital design.'|t }}</h2>
      </article>
    </div>
  </section>

  <section class="rp-section rp-principles" aria-labelledby="rp-principles-title">
    <div class="rp-shell">
      <div class="rp-editorial-heading rp-editorial-heading--compact">
        <span class="rp-eyebrow">{{ 'How we work'|t }}</span>
        <h2 id="rp-principles-title">{{ 'Principles that guide every Ropleon product.'|t }}</h2>
      </div>
      <div class="rp-principle-list">
        <span>{{ 'Clarity'|t }}</span>
        <span>{{ 'Reliability'|t }}</span>
        <span>{{ 'Security'|t }}</span>
        <span>{{ 'Interoperability'|t }}</span>
        <span>{{ 'Quality'|t }}</span>
        <span>{{ 'Continuous improvement'|t }}</span>
      </div>
    </div>
  </section>

  <section class="rp-section rp-dark-cta">
    <div class="rp-shell rp-dark-cta__inner">
      <div>
        <span class="rp-eyebrow rp-eyebrow--dark">{{ 'Our first product'|t }}</span>
        <h2>{{ 'See connected design in action with Ropleon Cards.'|t }}</h2>
      </div>
      <a class="rp-button rp-button--primary" href="{{ urls.cards }}">{{ 'Explore Ropleon Cards'|t }}</a>
    </div>
  </section>
</div>
