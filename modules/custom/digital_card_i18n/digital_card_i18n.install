<?php

use Drupal\language\Entity\ConfigurableLanguage;
use Drupal\locale\Gettext;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_install().
 */
function digital_card_i18n_install(): void {
  digital_card_i18n_configure();
  digital_card_i18n_import_arabic();
}

/**
 * Applies multilingual defaults to existing installations.
 */
function digital_card_i18n_update_10001(): string {
  digital_card_i18n_configure();
  digital_card_i18n_import_arabic();
  return 'Arabic language, URL prefixes, content translation, and editable platform translations were configured.';
}

