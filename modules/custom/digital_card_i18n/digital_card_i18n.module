/**
 * Returns the source title for custom/View routes whose titles are config.
 */
function digital_card_i18n_path_title(): ?string {
  $path = \Drupal::service('path.current')->getPath();
  if (preg_match('#^/group/\d+/content/create/group_node(?::|%3A)digital_business_card$#i', $path)) {
    return 'Add Digital Card';
  }
  if (preg_match('#^/group/\d+/members$#', $path)) {
    return 'Members';
  }
  if (preg_match('#^/group/\d+/nodes$#', $path)) {
    return 'Content';
  }
  if (preg_match('#^/group/\d+/content/add/group_membership$#', $path)) {
    return 'Add member';
  }
  return match ($path) {
    '/organization/dashboard' => 'Organization Dashboard',
    '/organization/my-cards', '/organization/my-cards-legacy', '/organization/cards' => 'My Cards',
    '/organization/subscription', '/organization/subscriptions' => 'My Subscription',
    '/organization/administrators' => 'Organization Administrators',
    '/platform-plans' => 'Plans',
    '/platform-subscriptions', '/node/organization_subscription' => 'Subscriptions',
    '/organization-administrators' => 'Organization Administrators',
    '/platform-digital-Cards' => 'Card Approval Queue',
    default => NULL,
  };
}
