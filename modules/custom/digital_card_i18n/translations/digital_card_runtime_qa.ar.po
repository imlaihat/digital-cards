msgid "One subscription is due for renewal within 30 days."
msgid_plural "@count subscriptions are due for renewal within 30 days."
msgstr[0] "لا توجد اشتراكات تستحق التجديد خلال 30 يوماً."
msgstr[1] "يوجد اشتراك واحد يستحق التجديد خلال 30 يوماً."
msgstr[2] "يوجد اشتراكان يستحقان التجديد خلال 30 يوماً."
msgstr[3] "توجد @count اشتراكات تستحق التجديد خلال 30 يوماً."
msgstr[4] "يوجد @count اشتراكاً يستحق التجديد خلال 30 يوماً."
msgstr[5] "يوجد @count اشتراك يستحق التجديد خلال 30 يوماً."

msgid "One card is waiting for approval."
msgid_plural "@count cards are waiting for approval."
msgstr[0] "لا توجد بطاقات بانتظار الاعتماد."
msgstr[1] "توجد بطاقة واحدة بانتظار الاعتماد."
msgstr[2] "توجد بطاقتان بانتظار الاعتماد."
msgstr[3] "توجد @count بطاقات بانتظار الاعتماد."
msgstr[4] "توجد @count بطاقة بانتظار الاعتماد."
msgstr[5] "توجد @count بطاقة بانتظار الاعتماد."

msgid "One expired subscription was detected. Public cards for this organization may be unavailable until service is renewed."
msgid_plural "@count expired subscriptions were detected. Public cards for these organizations may be unavailable until service is renewed."
msgstr[0] "لم يتم اكتشاف اشتراكات منتهية."
msgstr[1] "تم اكتشاف اشتراك منتهٍ واحد. قد تتوقف البطاقات العامة لهذه المؤسسة حتى تجديد الخدمة."
msgstr[2] "تم اكتشاف اشتراكين منتهيين. قد تتوقف البطاقات العامة لهاتين المؤسستين حتى تجديد الخدمة."
msgstr[3] "تم اكتشاف @count اشتراكات منتهية. قد تتوقف البطاقات العامة لهذه المؤسسات حتى تجديد الخدمة."
msgstr[4] "تم اكتشاف @count اشتراكاً منتهياً. قد تتوقف البطاقات العامة لهذه المؤسسات حتى تجديد الخدمة."
msgstr[5] "تم اكتشاف @count اشتراك منتهٍ. قد تتوقف البطاقات العامة لهذه المؤسسات حتى تجديد الخدمة."

