{#
/**
 * @file
 * Branded anonymous login gateway for Ropleon Cards.
 */
#}
<div class="dp-auth-shell dp-login-gateway">
  <section class="dp-auth-brand" aria-labelledby="dp-auth-brand-title">
    <div class="dp-auth-brand__glow dp-auth-brand__glow--one"></div>
    <div class="dp-auth-brand__glow dp-auth-brand__glow--two"></div>

    <a class="dp-auth-logo" href="{{ front_page }}" aria-label="{{ 'Ropleon Technologies home'|t }}">
      <img class="dp-auth-logo__image" src="{{ ropleon_assets.product_logo }}" alt="{{ ropleon_brand.product_name }}">
    </a>

    <div class="dp-auth-brand__content">
      <span class="dp-auth-eyebrow">{{ 'Enterprise digital identity'|t }}</span>
      <h1 id="dp-auth-brand-title">{{ 'Your identity. Always connected.'|t }}</h1>
      <p>{{ 'Manage branded digital cards, organization access, merchant benefits, and loyalty from one connected workspace.'|t }}</p>

      <ul class="dp-auth-benefits" role="list">
        <li><span aria-hidden="true">&#10003;</span>{{ 'Branded cards for every organization'|t }}</li>
        <li><span aria-hidden="true">&#10003;</span>{{ 'Loyalty points and exclusive offers'|t }}</li>
        <li><span aria-hidden="true">&#10003;</span>{{ 'Fast merchant verification and redemption'|t }}</li>
      </ul>
    </div>

    <div class="dp-auth-security">
      <img class="dp-auth-security__icon" src="{{ ropleon_assets.favicon }}" alt="" aria-hidden="true">
      <span>
        <strong>{{ ropleon_brand.product_branding_line|default('Powered by Ropleon Cards.')|t }}</strong>
        <small>{{ ropleon_brand.company_legal_name|default('Ropleon Technologies') }} · {{ ropleon_brand.company_tagline|default('Technology, Connected.')|t }}</small>
      </span>
    </div>
  </section>

  <main class="dp-auth-main" id="main-content">
    <div class="dp-auth-card">
      <div class="dp-auth-card__header">
        <span class="dp-auth-card__icon" aria-hidden="true">&#8594;</span>
        <div>
          <h2>{{ 'Welcome back'|t }}</h2>
          <p>{{ 'Sign in to manage your business workspace.'|t }}</p>
        </div>
      </div>

      {% if page.highlighted %}
        <div class="dp-auth-messages">{{ page.highlighted }}</div>
      {% endif %}

      <div class="dp-auth-form-wrap">
        {{ page.content }}
      </div>

      <div class="dp-auth-card__footer">
        <span aria-hidden="true">&#9679;</span>
        <a href="{{ front_page }}">{{ 'Back to Ropleon Technologies'|t }}</a>
      </div>
    </div>
  </main>
</div>
