{#
/**
 * @file
 * One modern organization card tile in the My Cards View.
 */
#}
{% set card = dc_card %}

<article class="dc-card-tile">
  <a class="dc-card-tile__media" href="{{ path('entity.node.canonical', {'node': card.id}) }}" aria-label="{{ 'View card'|t }}: {{ card.full_name }}">
    <span class="dc-card-tile__brand-accent" aria-hidden="true"></span>
    <span class="dc-card-tile__avatar">{{ card.profile_image }}</span>
  </a>

  <div class="dc-card-tile__body">
    <div class="dc-card-tile__identity">
      <h2><a href="{{ path('entity.node.canonical', {'node': card.id}) }}">{{ card.full_name }}</a></h2>
      {% if card.job_title %}<p>{{ card.job_title }}</p>{% endif %}
    </div>

    <span class="dc-card-tile__status dc-card-tile__status--{{ card.status_class }}">{{ card.status_label }}</span>

    <div class="dc-card-tile__actions">
      <a href="{{ path('entity.node.canonical', {'node': card.id}) }}">
        <i class="bi bi-eye" aria-hidden="true"></i><span>{{ 'View card'|t }}</span>
      </a>
      <a href="{{ path('entity.node.edit_form', {'node': card.id}) }}">
        <i class="bi bi-pencil" aria-hidden="true"></i><span>{{ 'Edit card'|t }}</span>
      </a>
    </div>
  </div>
</article>
