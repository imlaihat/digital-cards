{#
/**
 * @file
 * Organization-scoped image-card listing.
 */
#}
<section class="dc-my-cards-page">
  <header class="dc-my-cards-hero">
    <div>
      <span class="dc-my-cards-hero__eyebrow">{{ 'Organization cards'|t }}</span>
      <h1>{{ 'My Digital Cards'|t }}</h1>
      <p>{{ 'View and maintain card-holder profiles, photos, and approval status.'|t }}</p>
    </div>
    <a class="dc-my-cards-add" href="{{ path('digital_card_admin.organization_cards') }}">
      <i class="bi bi-plus-circle" aria-hidden="true"></i>
      <span>{{ 'Add New Card'|t }}</span>
    </a>
  </header>

  {% if exposed %}
    <div class="dc-my-cards-filters">{{ exposed }}</div>
  {% endif %}

  {% if rows %}
    <div class="dc-my-cards-grid">{{ rows }}</div>
  {% elseif empty %}
    <div class="dc-my-cards-empty">{{ empty }}</div>
  {% endif %}

  {% if pager %}
    <div class="dc-my-cards-pager">{{ pager }}</div>
  {% endif %}

  {{ attachment_before }}
  {{ attachment_after }}
  {{ more }}
</section>
