<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit digital_platform.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Builds a cache-safe URL for any production theme asset.
 */
function digital_platform_theme_asset_url(string $relative_path): string {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('digital_platform');
  $normalized_path = ltrim(str_replace('\\', '/', $relative_path), '/');
  $relative_file = $theme_path . '/assets/' . $normalized_path;
  $absolute_path = DRUPAL_ROOT . '/' . $relative_file;
  $version = is_file($absolute_path) ? (string) filemtime($absolute_path) : '1';

  return base_path() . $relative_file . '?v=' . rawurlencode($version);
}

/**
 * Builds a cache-safe URL for an approved Ropleon brand asset.
 */
function digital_platform_brand_asset_url(string $filename): string {
  return digital_platform_theme_asset_url('brand/' . ltrim($filename, '/'));
}

/**
 * Ensures Drupal's standard Site Branding block uses approved artwork.
 */
function digital_platform_preprocess_block(array &$variables): void {
  if (($variables['elements']['#plugin_id'] ?? '') !== 'system_branding_block') {
    return;
  }

  if (isset($variables['content']['site_logo']) && is_array($variables['content']['site_logo'])) {
    $variables['content']['site_logo']['#uri'] = digital_platform_brand_asset_url('ropleon-technologies.svg');
    $variables['content']['site_logo']['#alt'] = t('Ropleon Technologies');
  }
}

/**
 * Keeps the supplied Ropleon icon as the single favicon source.
 */
function digital_platform_page_attachments_alter(array &$attachments): void {
  $links = $attachments['#attached']['html_head_link'] ?? [];
  foreach ($links as $key => $link) {
    $attributes = is_array($link) && isset($link[0]) && is_array($link[0]) ? $link[0] : [];
    $rel = strtolower((string) ($attributes['rel'] ?? ''));
    if (in_array($rel, ['icon', 'shortcut icon', 'apple-touch-icon', 'manifest'], TRUE)) {
      unset($links[$key]);
    }
  }

  $links = array_values($links);
  $links[] = [[
    'rel' => 'icon',
    'href' => digital_platform_brand_asset_url('favicon.svg'),
    'type' => 'image/svg+xml',
  ], TRUE];
  $links[] = [[
    'rel' => 'icon',
    'href' => digital_platform_brand_asset_url('ropleon-icon-32x32.png'),
    'type' => 'image/png',
    'sizes' => '32x32',
  ], TRUE];
  $links[] = [[
    'rel' => 'icon',
    'href' => digital_platform_brand_asset_url('ropleon-icon-16x16.png'),
    'type' => 'image/png',
    'sizes' => '16x16',
  ], TRUE];
  $links[] = [[
    'rel' => 'shortcut icon',
    'href' => digital_platform_brand_asset_url('favicon.ico'),
    'type' => 'image/x-icon',
  ], TRUE];
  $links[] = [[
    'rel' => 'apple-touch-icon',
    'href' => digital_platform_brand_asset_url('apple-touch-icon.png'),
    'sizes' => '180x180',
  ], TRUE];
  $links[] = [[
    'rel' => 'manifest',
    'href' => digital_platform_brand_asset_url('site.webmanifest'),
  ], TRUE];
  $attachments['#attached']['html_head_link'] = $links;
  $attachments['#attached']['html_head'][] = [[
    '#tag' => 'meta',
    '#attributes' => [
      'name' => 'theme-color',
      'content' => '#00184A',
    ],
  ], 'ropleon_theme_color'];
  $attachments['#attached']['html_head'][] = [[
    '#tag' => 'meta',
    '#attributes' => [
      'name' => 'application-name',
      'content' => 'Ropleon',
    ],
  ], 'ropleon_application_name'];
}

/**
 * Translates select placeholders that are finalized during theme preprocessing.
 */
function digital_platform_preprocess_select(array &$variables): void {
  if (\Drupal::languageManager()->getCurrentLanguage()->getId() !== 'ar' || empty($variables['options'])) {
    return;
  }
  foreach ($variables['options'] as &$option) {
    if (is_array($option) && ($option['type'] ?? '') === 'option' && (string) ($option['value'] ?? '') === '_none') {
      $option['label'] = t('- None -', [], ['langcode' => 'ar']);
    }
  }
  unset($option);
}

/**
 * Returns the authenticated Ropleon workspace for the current account.
 */
function digital_platform_authenticated_portal_context(?string $route_name = NULL): string {
  $account = \Drupal::currentUser();
  if ($account->isAnonymous()) {
    return '';
  }

  $route_name ??= (string) \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, [
    'ropleon_brand.home',
    'ropleon_brand.products',
    'ropleon_brand.cards',
    'ropleon_brand.solutions',
    'ropleon_brand.about',
    'ropleon_brand.privacy',
    'ropleon_brand.terms',
    'contact.site_page',
    'user.login',
    'user.pass',
  ], TRUE)) {
    return '';
  }

  if ($account->hasPermission('access platform admin dashboard')) {
    return 'platform';
  }
  if ($account->hasPermission('access organization portal dashboard')) {
    return 'organization';
  }
  if (
    $account->hasPermission('check card holder offer eligibility')
    || $account->hasPermission('redeem card holder offers')
  ) {
    return 'merchant';
  }

  return '';
}

/**
 * Builds reliable language links for the current public or portal page.
 *
 * Core's placed language block can retain the active prefix when switching
 * authenticated pages in this installation. Building the target from the
 * configured URL prefixes preserves the current path and query while ensuring
 * that /ar and /en are actually exchanged in both directions.
 */
function digital_platform_language_switch_links(): array {
  $request = \Drupal::request();
  $language_manager = \Drupal::languageManager();
  $current_langcode = $language_manager->getCurrentLanguage()->getId();
  $prefixes = \Drupal::config('language.negotiation')->get('url.prefixes') ?: [];
  $path = '/' . ltrim($request->getPathInfo(), '/');

  // Remove any configured language prefix before adding the requested one.
  $configured_prefixes = array_values(array_filter(array_map(
    static fn($prefix): string => trim((string) $prefix, '/'),
    $prefixes
  )));
  if ($configured_prefixes) {
    $quoted = array_map(
      static fn(string $prefix): string => preg_quote($prefix, '#'),
      $configured_prefixes
    );
    $path = (string) preg_replace(
      '#^/(?:' . implode('|', $quoted) . ')(?=/|$)#',
      '',
      $path,
      1
    );
  }
  $path = '/' . ltrim($path, '/');

  $base = rtrim(base_path(), '/');
  $query = $request->getQueryString();
  $links = [];
  foreach ($language_manager->getLanguages() as $langcode => $language) {
    if (!in_array($langcode, ['en', 'ar'], TRUE)) {
      continue;
    }

    $prefix = trim((string) ($prefixes[$langcode] ?? $langcode), '/');
    $language_root = $base . ($prefix !== '' ? '/' . $prefix : '');
    $url = ($language_root !== '' ? $language_root : '/')
      . ($path === '/' ? '' : $path);
    if ($query !== NULL && $query !== '') {
      $url .= '?' . $query;
    }

    $links[] = [
      'label' => $langcode === 'ar' ? 'العربية' : 'English',
      'langcode' => $langcode,
      'active' => $langcode === $current_langcode,
      'url' => $url,
      'absolute_url' => $request->getSchemeAndHttpHost() . $url,
      'direction' => $language->getDirection(),
    ];
  }

  return $links;
}

/**
 * Removes obsolete placed language blocks from portal regions.
 */
function digital_platform_remove_legacy_language_blocks(array &$build): void {
  foreach ($build as $key => &$child) {
    if (!is_array($child)) {
      continue;
    }
    $plugin_id = (string) ($child['#plugin_id'] ?? '');
    if (str_starts_with($plugin_id, 'language_block:')) {
      unset($build[$key]);
      continue;
    }
    digital_platform_remove_legacy_language_blocks($child);
  }
  unset($child);
}

/**
 * Uses a user-facing title for the Group card-creation route.
 */
function digital_platform_preprocess_html(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (
    \Drupal::languageManager()->getCurrentLanguage()->getId() === 'ar'
    && $route_name === 'entity.group_relationship.create_form'
  ) {
    $variables['head_title']['title'] = t('Add Digital Card', [], ['langcode' => 'ar']);
  }

  if ($route_name === 'user.login') {
    $variables['head_title']['title'] = t('Sign in to Ropleon Cards');
  }
  elseif ($route_name === 'contact.site_page') {
    $variables['head_title']['title'] = t('Contact Ropleon Technologies');
  }

  if (in_array($route_name, [
    'ropleon_brand.home',
    'ropleon_brand.products',
    'ropleon_brand.cards',
    'ropleon_brand.solutions',
    'ropleon_brand.about',
    'ropleon_brand.privacy',
    'ropleon_brand.terms',
    'contact.site_page',
  ], TRUE)) {
    $variables['head_title']['name'] = t('Ropleon Technologies');
    $variables['head_title']['slogan'] = t('Technology. Connected.');
  }

  $portal_context = digital_platform_authenticated_portal_context((string) $route_name);
  if ($portal_context !== '') {
    $variables['attributes']['class'][] = 'rp-authenticated-portal';
    $variables['attributes']['class'][] = 'rp-authenticated-portal--' . $portal_context;
    $variables['head_title']['name'] = $portal_context === 'platform'
      ? t('Ropleon Technologies')
      : t('Ropleon Cards');
    $variables['head_title']['slogan'] = match ($portal_context) {
      'platform' => t('Platform Portal'),
      'organization' => t('Organization Portal'),
      'merchant' => t('Merchant Portal'),
      default => '',
    };
  }
}

/**
 * Uses a user-facing visible title for the Group card-creation route.
 */
function digital_platform_preprocess_page_title(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (
    \Drupal::languageManager()->getCurrentLanguage()->getId() === 'ar'
    && $route_name === 'entity.group_relationship.create_form'
  ) {
    $variables['title'] = t('Add Digital Card', [], ['langcode' => 'ar']);
  }
  elseif ($route_name === 'contact.site_page') {
    $variables['title'] = t('Contact Ropleon Technologies');
  }
}

/**
 * Keeps organization-facing entity pages focused on business information.
 */
function digital_platform_preprocess_node(array &$variables): void {
  if (
    \Drupal::languageManager()->getCurrentLanguage()->getId() === 'ar'
    && !empty($variables['node'])
    && in_array($variables['node']->bundle(), ['digital_business_card', 'organization_subscription', 'subscription_plan'], TRUE)
  ) {
    $variables['display_submitted'] = FALSE;
  }
}

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * Example on how to alter theme settings form
 */
function digital_platform_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for the core login form.
 */
function digital_platform_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#attributes']['class'][] = 'dp-login-form';
  $form['#attached']['library'][] = 'digital_platform/login';

  $form['name']['#title'] = t('Email or username');
  $form['name']['#description'] = t('Enter the username or email address assigned to your platform account.');
  $form['name']['#attributes']['autocomplete'] = 'username';
  $form['name']['#attributes']['autofocus'] = 'autofocus';

  $form['pass']['#title'] = t('Password');
  $form['pass']['#attributes']['autocomplete'] = 'current-password';

  $form['actions']['submit']['#value'] = t('Sign in securely');
  $form['actions']['submit']['#attributes']['class'][] = 'dp-login-submit';

  $form['password_help'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['dp-login-help']],
    'label' => ['#markup' => '<span>' . t('Forgot your password?') . '</span>'],
    'link' => [
      '#type' => 'link',
      '#title' => t('Reset it here'),
      '#url' => \Drupal\Core\Url::fromRoute('user.pass'),
      '#attributes' => ['class' => ['dp-login-help__link']],
    ],
    '#weight' => 110,
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for the public contact form.
 */
function digital_platform_form_contact_message_feedback_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#attributes']['class'][] = 'rp-contact-form';
  $form['name']['#title'] = t('Full name');
  $form['name']['#weight'] = 0;

  if (\Drupal::currentUser()->isAuthenticated()) {
    // Core deliberately renders an authenticated account email as a read-only
    // item. Keep that identity value for Drupal's form processing, but provide
    // a genuine Work email field for this business enquiry.
    $default_email = trim((string) ($form['mail']['#value'] ?? ''));
    $form['mail']['#access'] = FALSE;
    $form['work_email'] = [
      '#type' => 'email',
      '#title' => t('Work email'),
      '#default_value' => $default_email,
      '#required' => TRUE,
      '#maxlength' => 254,
      '#attributes' => [
        'autocomplete' => 'email',
        'inputmode' => 'email',
      ],
      '#weight' => 1,
    ];
  }
  else {
    $form['mail']['#title'] = t('Work email');
    $form['mail']['#weight'] = 1;
    $form['mail']['#attributes']['autocomplete'] = 'email';
    $form['mail']['#attributes']['inputmode'] = 'email';
  }

  $subject = (string) t('Ropleon website enquiry');
  if (isset($form['subject']['widget'][0]['value'])) {
    // Subject is an entity-field widget. Hiding the outer wrapper produces an
    // unrelated "subject_wrapper" value and leaves the required field empty.
    // Populate and hide the real field input instead.
    $form['subject']['widget'][0]['value']['#type'] = 'hidden';
    $form['subject']['widget'][0]['value']['#value'] = $subject;
    $form['subject']['widget'][0]['value']['#default_value'] = $subject;
    $form['subject']['widget'][0]['value']['#required'] = TRUE;
    $form['subject']['widget'][0]['value']['#title_display'] = 'invisible';
  }
  $form['copy']['#access'] = FALSE;

  $form['organization'] = [
    '#type' => 'textfield',
    '#title' => t('Organization'),
    '#required' => TRUE,
    '#maxlength' => 160,
    '#weight' => 2,
  ];
  $form['phone'] = [
    '#type' => 'tel',
    '#title' => t('Phone number'),
    '#description' => t('Optional'),
    '#maxlength' => 40,
    '#weight' => 3,
  ];
  $form['interest'] = [
    '#type' => 'select',
    '#title' => t('Area of interest'),
    '#required' => TRUE,
    '#empty_option' => t('- Select -'),
    '#options' => [
      'cards' => t('Ropleon Cards'),
      'software' => t('Enterprise software'),
      'integration' => t('System integration'),
      'ai' => t('AI and automation'),
      'cloud' => t('Cloud and digital platforms'),
      'partnership' => t('Partnership'),
      'other' => t('Other'),
    ],
    '#weight' => 4,
  ];
  $form['message']['#weight'] = 5;
  $form['consent'] = [
    '#type' => 'checkbox',
    '#title' => t('I agree that Ropleon may use the information provided to respond to this enquiry.'),
    '#required' => TRUE,
    '#weight' => 6,
  ];

  if (!empty($form['actions']['submit']['#submit']) && is_array($form['actions']['submit']['#submit'])) {
    // ContentEntityForm first copies submitted values to the entity and then
    // saves it. Add our business context between those two callbacks.
    $callbacks = $form['actions']['submit']['#submit'];
    $save_index = array_search('::save', $callbacks, TRUE);
    if ($save_index === FALSE) {
      $callbacks[] = 'digital_platform_contact_context_submit';
    }
    else {
      array_splice($callbacks, $save_index, 0, ['digital_platform_contact_context_submit']);
    }
    $callbacks[] = 'digital_platform_contact_success_submit';
    $form['actions']['submit']['#submit'] = $callbacks;
  }
}

/**
 * Adds structured enquiry context to the stored and emailed contact message.
 */
function digital_platform_contact_context_submit(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }
  $message = $form_object->getEntity();
  if (!$message || !method_exists($message, 'setMessage')) {
    return;
  }
  $work_email = trim((string) $form_state->getValue('work_email'));
  if ($work_email !== '' && method_exists($message, 'setSenderMail')) {
    $message->setSenderMail($work_email);
  }
  $interest_options = $form['interest']['#options'] ?? [];
  $interest_key = (string) $form_state->getValue('interest');
  $interest = isset($interest_options[$interest_key]) ? (string) $interest_options[$interest_key] : $interest_key;
  $context = [
    (string) t('Organization') . ': ' . trim((string) $form_state->getValue('organization')),
    (string) t('Phone number') . ': ' . (trim((string) $form_state->getValue('phone')) ?: (string) t('Not provided')),
    (string) t('Area of interest') . ': ' . $interest,
  ];
  $message->setMessage(implode(PHP_EOL, $context) . PHP_EOL . PHP_EOL . $message->getMessage());
}

/**
 * Uses the approved public confirmation message.
 */
function digital_platform_contact_success_submit(array &$form, FormStateInterface $form_state): void {
  \Drupal::messenger()->deleteAll();
  \Drupal::messenger()->addStatus(t('Thank you for contacting Ropleon. Your message has been received.'));
}

/**
 * Implements hook_preprocess_page().
 */
function digital_platform_preprocess_page(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  $variables['ropleon_languages'] = digital_platform_language_switch_links();
  $is_login_gateway = $route_name === 'system.403' && \Drupal::currentUser()->isAnonymous();
  $public_routes = [
    'ropleon_brand.home',
    'ropleon_brand.products',
    'ropleon_brand.cards',
    'ropleon_brand.solutions',
    'ropleon_brand.about',
    'ropleon_brand.privacy',
    'ropleon_brand.terms',
    'contact.site_page',
  ];

  if ($route_name === 'user.login' || $is_login_gateway) {
    $variables['#attached']['library'][] = 'digital_platform/login';
    $variables['#attached']['html_head'][] = [[
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'robots',
        'content' => 'noindex, nofollow',
      ],
    ], 'ropleon_login_robots'];
    $config = \Drupal::config('ropleon_brand.settings');
    $variables['ropleon_brand'] = [
      'company_name' => (string) ($config->get('company_name') ?: 'Ropleon'),
      'company_legal_name' => (string) ($config->get('company_legal_name') ?: 'Ropleon Technologies'),
      'company_name_ar' => (string) ($config->get('company_name_ar') ?: 'روبليون'),
      'company_tagline' => (string) ($config->get('company_tagline') ?: 'Technology. Connected.'),
      'product_name' => (string) ($config->get('product_name') ?: 'Ropleon Cards'),
      'product_tagline' => (string) ($config->get('product_tagline') ?: 'Your Identity. Always Connected.'),
      'product_branding_line' => (string) ($config->get('product_branding_line') ?: 'Powered by Ropleon Cards.'),
    ];
    $theme_path = \Drupal::service('extension.list.theme')->getPath('digital_platform');
    $variables['ropleon_assets'] = [
      'company_logo' => digital_platform_brand_asset_url('ropleon-technologies.svg'),
      'company_mark' => digital_platform_brand_asset_url('corporate/svg/ropleon-approved-master-color.svg'),
      'company_logo_inverse' => digital_platform_brand_asset_url('corporate/svg/ropleon-technologies-mono-white.svg'),
      'product_logo' => digital_platform_brand_asset_url('ropleon-cards.svg'),
      'product_logo_inverse' => digital_platform_brand_asset_url('cards/svg/ropleon-cards-mono-white.svg'),
      'favicon' => digital_platform_brand_asset_url('favicon.svg'),
      'icons' => [
        'menu' => digital_platform_theme_asset_url('icons/menu.svg'),
        'close' => digital_platform_theme_asset_url('icons/close.svg'),
      ],
    ];
  }

  if (in_array($route_name, $public_routes, TRUE)) {
    $config = \Drupal::config('ropleon_brand.settings');
    $variables['#attached']['library'][] = 'digital_platform/ropleon-public';
    $variables['ropleon_brand'] = [
      'company_name' => (string) ($config->get('company_name') ?: 'Ropleon'),
      'company_legal_name' => (string) ($config->get('company_legal_name') ?: 'Ropleon Technologies'),
      'company_name_ar' => (string) ($config->get('company_name_ar') ?: 'روبليون'),
      'company_tagline' => (string) ($config->get('company_tagline') ?: 'Technology. Connected.'),
      'product_name' => (string) ($config->get('product_name') ?: 'Ropleon Cards'),
      'product_tagline' => (string) ($config->get('product_tagline') ?: 'Your Identity. Always Connected.'),
      'product_branding_line' => (string) ($config->get('product_branding_line') ?: 'Powered by Ropleon Cards.'),
    ];

    $front = Url::fromRoute('<front>')->toString();
    $variables['ropleon_navigation'] = [
      [
        'title' => t('Home'),
        'url' => $front,
        'active' => $route_name === 'ropleon_brand.home',
      ],
      [
        'title' => t('Solutions'),
        'url' => Url::fromRoute('ropleon_brand.solutions')->toString(),
        'active' => $route_name === 'ropleon_brand.solutions',
      ],
      [
        'title' => t('Products'),
        'url' => Url::fromRoute('ropleon_brand.products')->toString(),
        'active' => in_array($route_name, ['ropleon_brand.products', 'ropleon_brand.cards'], TRUE),
      ],
      [
        'title' => t('Company'),
        'url' => Url::fromRoute('ropleon_brand.about')->toString(),
        'active' => $route_name === 'ropleon_brand.about',
      ],
      [
        'title' => t('Contact'),
        'url' => Url::fromRoute('contact.site_page')->toString(),
        'active' => $route_name === 'contact.site_page',
      ],
      [
        'title' => t('Sign in'),
        'url' => Url::fromRoute('user.login')->toString(),
        'active' => FALSE,
      ],
    ];
    $variables['ropleon_product_action'] = [
      'title' => t('Explore Ropleon Cards'),
      'url' => Url::fromRoute('ropleon_brand.cards')->toString(),
      'active' => $route_name === 'ropleon_brand.cards',
    ];
    $variables['ropleon_public_page'] = match ($route_name) {
      'ropleon_brand.home' => 'home',
      'ropleon_brand.products' => 'products',
      'ropleon_brand.cards' => 'cards',
      'ropleon_brand.solutions' => 'solutions',
      'ropleon_brand.about' => 'about',
      'ropleon_brand.privacy' => 'privacy',
      'ropleon_brand.terms' => 'terms',
      'contact.site_page' => 'contact',
      default => '',
    };

    $default_language_url = '';
    foreach ($variables['ropleon_languages'] as $language) {
      $variables['#attached']['html_head_link'][] = [[
        'rel' => 'alternate',
        'hreflang' => $language['langcode'],
        'href' => $language['absolute_url'],
      ], TRUE];
      if ($language['langcode'] === 'en') {
        $default_language_url = $language['absolute_url'];
      }
    }
    if ($default_language_url !== '') {
      $variables['#attached']['html_head_link'][] = [[
        'rel' => 'alternate',
        'hreflang' => 'x-default',
        'href' => $default_language_url,
      ], TRUE];
    }

    $variables['ropleon_assets'] = [
      'company_logo' => digital_platform_brand_asset_url('ropleon-technologies.svg'),
      'company_mark' => digital_platform_brand_asset_url('corporate/svg/ropleon-approved-master-color.svg'),
      'company_logo_inverse' => digital_platform_brand_asset_url('corporate/svg/ropleon-technologies-mono-white.svg'),
      'product_logo' => digital_platform_brand_asset_url('ropleon-cards.svg'),
      'product_logo_inverse' => digital_platform_brand_asset_url('cards/svg/ropleon-cards-mono-white.svg'),
      'favicon' => digital_platform_brand_asset_url('favicon.svg'),
      'icons' => [
        'menu' => digital_platform_theme_asset_url('icons/menu.svg'),
        'close' => digital_platform_theme_asset_url('icons/close.svg'),
      ],
    ];

    $og_asset = $route_name === 'ropleon_brand.cards'
      ? 'social/cards/open-graph-1200x630.png'
      : 'social/corporate/open-graph-1200x630.png';
    $og_file = \Drupal::service('extension.list.theme')->getPath('digital_platform') . '/assets/' . $og_asset;
    if (is_file(DRUPAL_ROOT . '/' . $og_file)) {
      $absolute_og = \Drupal::request()->getSchemeAndHttpHost() . digital_platform_theme_asset_url($og_asset);
      $variables['#attached']['html_head'][] = [[
        '#tag' => 'meta',
        '#attributes' => ['property' => 'og:image', 'content' => $absolute_og],
      ], 'ropleon_og_image'];
      $variables['#attached']['html_head'][] = [[
        '#tag' => 'meta',
        '#attributes' => ['name' => 'twitter:image', 'content' => $absolute_og],
      ], 'ropleon_twitter_image'];
      $variables['#attached']['html_head'][] = [[
        '#tag' => 'meta',
        '#attributes' => ['name' => 'twitter:card', 'content' => 'summary_large_image'],
      ], 'ropleon_twitter_card'];
    }
  }

  $portal_context = digital_platform_authenticated_portal_context((string) $route_name);
  if ($portal_context !== '') {
    $account = \Drupal::currentUser();
    $theme_path = \Drupal::service('extension.list.theme')->getPath('digital_platform');
    $base_path = base_path();
    $variables['ropleon_portal_context'] = $portal_context;
    $variables['ropleon_portal_account_name'] = $account->getDisplayName();
    $variables['ropleon_assets'] = [
      'company_logo' => digital_platform_brand_asset_url('ropleon-technologies.svg'),
      'company_mark' => digital_platform_brand_asset_url('corporate/svg/ropleon-approved-master-color.svg'),
      'company_logo_inverse' => digital_platform_brand_asset_url('corporate/svg/ropleon-technologies-mono-white.svg'),
      'product_logo' => digital_platform_brand_asset_url('ropleon-cards.svg'),
      'product_logo_inverse' => digital_platform_brand_asset_url('cards/svg/ropleon-cards-mono-white.svg'),
      'favicon' => digital_platform_brand_asset_url('favicon.svg'),
    ];
    $variables['ropleon_portal_urls'] = [
      'company' => Url::fromRoute('<front>')->toString(),
      'products' => Url::fromRoute('ropleon_brand.products')->toString(),
      'cards' => Url::fromRoute('ropleon_brand.cards')->toString(),
      'account' => Url::fromRoute('entity.user.canonical', ['user' => $account->id()])->toString(),
      'logout' => Url::fromRoute('user.logout')->toString(),
      'merchant' => Url::fromRoute('digital_card_offers.merchant_portal')->toString(),
    ];
    $variables['#attached']['library'][] = 'digital_platform/portal-shell';
    if (!empty($variables['page']['breadcrumb']) && is_array($variables['page']['breadcrumb'])) {
      digital_platform_remove_legacy_language_blocks($variables['page']['breadcrumb']);
    }

    if (in_array($portal_context, ['platform', 'organization'], TRUE)) {
      $plugin_id = $portal_context === 'platform'
        ? 'digital_card_platform_admin_header'
        : 'digital_card_organization_portal_header';
      try {
        $block = \Drupal::service('plugin.manager.block')->createInstance($plugin_id, []);
        if ($block->access($account)) {
          $variables['ropleon_portal_header'] = $block->build();
          $variables['ropleon_portal_header']['#languages'] = $variables['ropleon_languages'];
        }
      }
      catch (\Throwable $exception) {
        \Drupal::logger('digital_platform')->error('Could not build the @portal header: @message', [
          '@portal' => $portal_context,
          '@message' => $exception->getMessage(),
        ]);
      }
    }

    if ($portal_context === 'merchant') {
      $variables['ropleon_merchant_navigation'] = [
        [
          'title' => t('Verify offers'),
          'url' => $variables['ropleon_portal_urls']['merchant'],
          'active' => str_starts_with(\Drupal::service('path.current')->getPath(), '/merchant/offers'),
        ],
        [
          'title' => t('My account'),
          'url' => $variables['ropleon_portal_urls']['account'],
          'active' => $route_name === 'entity.user.canonical',
        ],
        [
          'title' => t('Sign out'),
          'url' => $variables['ropleon_portal_urls']['logout'],
          'active' => FALSE,
        ],
      ];
    }
  }

  // The anonymous front-page access-denied response includes both the system
  // error block and the login block. The branded gateway needs only the form.
  if ($is_login_gateway && isset($variables['page']['content'])) {
    foreach ($variables['page']['content'] as $key => $build) {
      if (is_array($build) && ($build['#plugin_id'] ?? '') === 'system_main_block') {
        unset($variables['page']['content'][$key]);
      }
    }
  }
}

/**
 * Adds the official product artwork to the Ropleon Cards landing page.
 */
function digital_platform_preprocess_ropleon_cards_landing(array &$variables): void {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('digital_platform');
  $variables['ropleon_assets'] = [
    'product_logo' => digital_platform_brand_asset_url('ropleon-cards.svg'),
    'favicon' => digital_platform_brand_asset_url('favicon.svg'),
  ];
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function digital_platform_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'system.403' && \Drupal::currentUser()->isAnonymous()) {
    $suggestions[] = 'page__login_gateway';
  }

  if (in_array($route_name, [
    'ropleon_brand.home',
    'ropleon_brand.products',
    'ropleon_brand.cards',
    'ropleon_brand.solutions',
    'ropleon_brand.about',
    'ropleon_brand.privacy',
    'ropleon_brand.terms',
    'contact.site_page',
  ], TRUE)) {
    $suggestions[] = 'page__ropleon_public';
  }

  if (digital_platform_authenticated_portal_context((string) $route_name) !== '') {
    $suggestions[] = 'page__portal_shell';
  }
}
