{% set social_links = theme_settings.social_links ?? [] %}
<ul class="list-wrap" aria-label="Footer social media links">
  {% for link in social_links %}
    {% set platform = link.platform|lower %}
    {% set label = link.label %}
    {% set url = link.url %}
    {% set show_platform = theme_settings['footer_social_icons'][platform]|default(false) %}

    {% if url and show_platform %}
      <li>
        <a href="{{ url }}" 
           target="_blank" 
           rel="noopener noreferrer" 
           title="Follow us on {{ label }}" 
           aria-label="Follow us on {{ label }}">
          <i class="fab fa-{{ platform }}" aria-hidden="true"></i>
          <span class="visually-hidden">{{ label }}</span>
        </a>
      </li>
    {% endif %}
  {% endfor %}
</ul>
