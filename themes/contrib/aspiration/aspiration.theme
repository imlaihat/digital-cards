/**
 * Retrieves a list of color palette options with their labels.
 *
 * This function defines and returns an associative array of color options
 * used in the system, where the key represents a unique identifier for
 * each color palette, and the value represents the display name for the
 * color palette.
 *
 * The returned array is primarily used to provide color choices for
 * users in a UI or settings interface.
 *
 * @return array
 *   An associative array of color options where the key is
 *   a unique color identifier and the value is the color name.
 */
function aspiration_color_palettes() {
  // Define the options.
  $color_options = [
    'deep-ocean' => t('Deep Ocean'),
    'forest-green' => t('Forest Green'),
    'warm-desert' => t('Warm Desert'),
    'berry-purple' => t('Berry Purple'),
    'coastal-blue' => t('Coastal Blue'),
    'ruby-red' => t('Ruby Red'),
    'midnight-tech' => t('Midnight Tech'),
    'golden-amber' => t('Golden Amber'),
    'olive-green' => t('Olive Green'),
    'sunset-orange' => t('Sunset Orange'),
    'lavender-dream' => t('Lavender Dream'),
    'emerald-isle' => t('Emerald Isle'),
    'nordic-frost' => t('Nordic Frost'),
    'rose-gold' => t('Rose Gold'),
    'matcha-green' => t('Matcha Green'),
    'indigo-night' => t('Indigo Night'),
    'coral-sunset' => t('Coral Sunset'),
    'slate-blue' => t('Slate Blue'),
    'autumn-harvest' => t('Autumn Harvest'),
    'turquoise-bay' => t('Turquoise Bay'),
    'midnight-sapphire' => t('Midnight Sapphire'),
    'carbon-elegance' => t('Carbon Elegance'),
    'teal-fusion' => t('Teal Fusion'),
    'crimson-elegance' => t('Crimson Elegance'),
    'driftwood-neutrals' => t('Driftwood Neutrals'),
    'electric-violet' => t('Electric Violet'),
    'aquamarine-breeze' => t('Aquamarine Breeze'),
    'amber-glow' => t('Amber Glow'),
    'urban-concrete' => t('Urban Concrete'),
    'moroccan-spice' => t('Moroccan Spice'),
    'custom' => t('Custom'),
  ];

  return $color_options;
}

/**
 * Updates the slider images for the Aspiration theme if not already updated.
 *
 * This function checks if the slideshow display setting is enabled and if the 
 * slider images have not been previously updated. If these conditions are met,
 * it will copy the image files from the theme directory to the public file system,
 * create file entities, and save the image IDs in the theme settings.
 * 
 * Specifically:
 * - It verifies if the slider images need to be updated by checking the 'slideshow_display' 
 *   and 'slider_img_updated' settings.
 * - If images are missing in the public file system, they are copied from the theme's
 *   assets directory to the public file system.
 * - Each image is saved as a permanent file entity in Drupal, and the IDs of these 
 *   file entities are stored in the theme settings for later use.
 * - The 'slider_img_updated' setting is updated to `TRUE` once the images are successfully updated.
 * 
 * This function is typically used to initialize or update the slider images upon theme setup.
 *
 * @return void
 */
function aspiration_update_slider_images() {
  if (theme_get_setting('slideshow_display') && !theme_get_setting('slider_img_updated')) {
    // Define the path to the theme using Drupal's API.
    $themeHandler = \Drupal::service('theme_handler');
    $theme_path = $themeHandler->getTheme('aspiration')->getPath();
    $image_directory = $theme_path . '/assets/img/slider/';

    // Image file names.
    $image_files = [
      'aspiration-slider-1.png',
      'aspiration-slider-2.jpg',
      'aspiration-slider-3.png',
    ];

    // Prepare an array to store file IDs for the theme settings.
    $file_ids = [];

    // Image file names.
    $image_files = [
      'aspiration-slider-1.png',
      'aspiration-slider-2.jpg',
      'aspiration-slider-3.png',
    ];
    
    foreach ($image_files as $image_file) {
      // Check if the file exists in the theme directory.
      $file_path = $image_directory . $image_file;
      if (file_exists($file_path)) {
        // Define the public path where we will save the file.
        $public_file_path = 'public://themes/aspiration/slider/' . $image_file;

        // Check if the realpath is not empty and file doesn't exist yet.
        if (!$public_file_path || !file_exists($public_file_path)) {
          // Read the file contents from the theme directory.
          $file_contents = file_get_contents($file_path);

          // Ensure the public directory exists, otherwise create it.
          $directory = dirname($public_file_path);
          if (!file_exists($directory)) {
            mkdir($directory, 0775, TRUE);
          }

          // Check if the directory exists now.
          if (file_exists($directory)) {
            // Save the file to the public file system.
            file_put_contents($public_file_path, $file_contents);

            // Create a file entity to track the file in Drupal.
            $file = File::create([
              'uri' => $public_file_path,
            ]);
            $file->setPermanent();
            $file->save();
          }
        }
        else {
          // If the file already exists, load the existing file object by URI.
          $file = \Drupal::entityTypeManager()
            ->getStorage('file')
            ->loadByProperties(['uri' => $public_file_path]);

          // Get the first file object from the result set (it should be unique)
          $file = reset($file);
        }

        // If a valid file object exists, store its file ID.
        if ($file) {
          $file_ids[] = $file->id();
        }
      }
    }

    // Get the config object for the theme settings.
    $config = \Drupal::configFactory()->getEditable('aspiration.settings');

    // If the files were successfully uploaded or found, update the theme settings.
    if (!empty($file_ids)) {
      $config->set('slide1_image', [$file_ids[0]]);
      $config->set('slide2_image', [$file_ids[1]]);
      $config->set('slide3_image', [$file_ids[2]]);
    }

    $config->set('slider_img_updated', true);
    $config->save();
  }
}
